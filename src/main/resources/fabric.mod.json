{
  "schemaVersion": 1,
  "id": "colorlight",
  "version": "${version}",
  "name": "ColorLight",
  "description": "The ColorLight mod replaces vanilla block lighting with lighting that matches each block's texture.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/colorlight/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.mrhikmen.colorlight.ColorLightClient"
    ],
    "sodium:config_api_user": [
      "me.mrhikmen.colorlight.config.sodium.ColorLightSodiumConfig"
    ]
  },
  "mixins" : [
    "colorlighting.mixins.json"
    ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}"
  }
}
