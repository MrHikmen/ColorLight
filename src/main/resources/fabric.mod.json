{
  "schemaVersion": 1,
  "id": "colorlight",
  "version": "${version}",
  "name": "ColorLight",
  "description": "The ColorLight mod replaces vanilla block lighting with lighting that matches each block's texture.",
  "authors": [
    {
      "name": "MrHikmen"
    }
  ],
  "contact" : {
    "homepage" : "https://modrinth.com/mod/colorlight",
    "sources" : "https://github.com/MrHikmen/ColorLight",
    "issues" : "https://github.com/MrHikmen/ColorLight/issues"
  },
  "custom" : {
    "modmenu" : {
      "links" : {
        "modmenu.github" : "https://github.com/MrHikmen/ColorLight",
        "modmenu.modrinth" : "https://modrinth.com/mod/colorlight"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/colorlight/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.mrhikmen.colorlight.client.ColorLightClient"
    ],
    "sodium:config_api_user": [
      "me.mrhikmen.colorlight.client.config.gui.sodium.ColorLightSodiumConfig"
    ],
    "modmenu": [
      "me.mrhikmen.colorlight.client.config.gui.modmenu.ColorLightModMenu"
    ],
    "lambdynlights:initializer": [
      "me.mrhikmen.colorlight.client.compat.lambdynlights.ColorLightLambDynLightsInitializer"
    ]
  },
  "mixins" : [
    "colorlighting.mixins.json",
    {
      "config": "colorlight.sodium.mixins.json",
      "environment": "client"
    },
    {
      "config": "colorlight.voxy.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "~${minecraft_version}"
  },
  "suggests": {
    "sodium": "=> 0.8.0",
    "lambdynlights": "=> 4.0.0",
    "voxy": "=> 0.2.0"
  }
}
