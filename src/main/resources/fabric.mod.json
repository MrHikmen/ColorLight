{
  "schemaVersion": 1,
  "id": "colorlight",
  "version": "${version}",
  "name": "ColorLight",
  "description": "The ColorLight mod replaces vanilla block lighting with lighting that matches each block's texture.",
  "authors": [
    {
      "name": "MrHikmen"
    }
  ],
  "contact" : {
    "homepage" : "https://modrinth.com/mod/colorlight",
    "sources" : "https://github.com/MrHikmen/ColorLight",
    "issues" : "https://github.com/MrHikmen/ColorLight/issues"
  },
  "custom" : {
    "modmenu" : {
      "links" : {
        "modmenu.github" : "https://github.com/MrHikmen/ColorLight",
        "modmenu.modrinth" : "https://modrinth.com/mod/colorlight"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/colorlight/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.mrhikmen.colorlight.ColorLightClient"
    ],
    "sodium:config_api_user": [
      "me.mrhikmen.colorlight.config.ColorLightSodiumConfig"
    ],
    "modmenu": [
      "me.mrhikmen.colorlight.config.ColorLightModMenu"
    ]
  },
  "mixins" : [
    "colorlighting.mixins.json"
    ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": ">=26.1 >=26.1.2"
  },
  "suggests": {
    "sodium": "*"
  }
}
